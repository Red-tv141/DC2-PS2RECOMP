// G543 - default-off, exact offline VU1 semantic replay oracle.
//
// The saved G541 CPU corpus remains the authority. This gate replaces G542's copy shader with a
// real VU1 interpreter, generates post-state/post-pipeline/post-data/XGKICK output on the GPU, then
// performs one bounded readback and compares every generated byte. It never feeds data to gameplay.

#include "g543_vu_gpu_shader.inc"

constexpr uint32_t G543_STATUS_MAGIC = 0x4d455347u; // little-endian "GSEM"
constexpr uint32_t G543_STATUS_WORDS = 8u;

static bool g543LinkProgram(GLFns &f, GLuint &program, std::string &why)
{
    GLuint cs = 0u;
    std::string log;
    if (!g158CompileShader(f, GL541_COMPUTE_SHADER, g543SemanticShaderSource(), cs, log))
    {
        why = "compute compile failed: " + log;
        return false;
    }
    program = f.glCreateProgram_();
    f.glAttachShader_(program, cs);
    f.glLinkProgram_(program);
    GLint linked = 0;
    f.glGetProgramiv_(program, GL158_LINK_STATUS, &linked);
    f.glDeleteShader_(cs);
    if (!linked)
    {
        GLint len = 0;
        f.glGetProgramiv_(program, GL158_INFO_LOG_LENGTH, &len);
        std::vector<char> buf(len > 0 ? static_cast<size_t>(len) : 1u, 0);
        f.glGetProgramInfoLog_(program, static_cast<GLsizei>(buf.size()), nullptr, buf.data());
        why = "compute link failed: " + std::string(buf.data());
        return false;
    }
    return true;
}

struct G543Mismatch
{
    const char *section = "none";
    uint32_t record = 0xffffffffu;
    uint32_t byte = 0xffffffffu;
    uint32_t absoluteByte = 0xffffffffu;
    uint8_t expected = 0u;
    uint8_t actual = 0u;
    uint32_t expectedWord = 0u;
    uint32_t actualWord = 0u;
};

// A deferred history vector is consumed only through makeMac(value, dest). Lanes excluded by its
// recorded destination mask are never observed, never become architectural state, and never affect
// packets. NVIDIA may flush a denormal in such a dead lane while Release SSE2 preserves its bits;
// compare the semantic pipeline rather than forcing that inert payload through a shader spill cliff.
static bool g543HistoryPipeByteObservable(const uint8_t *expected, uint32_t pipeByteOffset,
                                          uint32_t relativeByte)
{
    const uint32_t word = relativeByte >> 2u;
    if (word < 82u || word >= 114u)
        return true;
    const uint32_t relative = word - 82u;
    const uint32_t slot = relative >> 2u;
    const uint32_t lane = relative & 3u;
    const uint32_t dest = g542ReadU32(expected + pipeByteOffset + (138u + slot) * 4u);
    return (dest & (8u >> lane)) != 0u;
}

static bool g543CompareSection(const G542AbiCorpus &corpus,
                               const std::vector<uint32_t> &output,
                               uint32_t record, const char *section,
                               uint32_t byteOffset, uint32_t byteCount,
                               G543Mismatch &mismatch)
{
    const uint64_t end = static_cast<uint64_t>(byteOffset) + byteCount;
    const uint64_t payloadBytes = static_cast<uint64_t>(corpus.payload.size()) * sizeof(uint32_t);
    const uint64_t outputBytes = static_cast<uint64_t>(output.size()) * sizeof(uint32_t);
    if (end > payloadBytes || end > outputBytes)
    {
        mismatch.section = section;
        mismatch.record = record;
        mismatch.byte = byteOffset;
        mismatch.absoluteByte = byteOffset;
        return false;
    }
    const auto *expected = reinterpret_cast<const uint8_t *>(corpus.payload.data());
    const auto *actual = reinterpret_cast<const uint8_t *>(output.data());
    const bool semanticPipe = std::strcmp(section, "postPipe") == 0;
    for (uint32_t b = 0u; b < byteCount; ++b)
    {
        if (semanticPipe && !g543HistoryPipeByteObservable(expected, byteOffset, b))
            continue;
        if (expected[byteOffset + b] == actual[byteOffset + b])
            continue;
        mismatch.section = section;
        mismatch.record = record;
        mismatch.byte = b;
        mismatch.absoluteByte = byteOffset + b;
        mismatch.expected = expected[byteOffset + b];
        mismatch.actual = actual[byteOffset + b];
        const uint32_t wordByte = (byteOffset + b) & ~3u;
        mismatch.expectedWord = g542ReadU32(expected + wordByte);
        mismatch.actualWord = g542ReadU32(actual + wordByte);
        return false;
    }
    return true;
}

static bool g543ValidateLayout(const G542AbiCorpus &corpus, std::string &why)
{
    for (uint32_t r = 0u; r < corpus.records; ++r)
    {
        const size_t c = static_cast<size_t>(r) * G542_ABI_WORDS;
        const uint32_t *cmd = corpus.commands.data() + c;
        if (cmd[16] - cmd[15] != 632u || cmd[17] - cmd[16] != 632u ||
            cmd[18] - cmd[17] != 644u || cmd[19] - cmd[18] != 644u ||
            cmd[20] - cmd[19] != 16384u || cmd[21] - cmd[20] != 16384u ||
            cmd[22] - cmd[21] != 16384u || cmd[11] != 0u)
        {
            why = "record " + std::to_string(r) + " is outside the G543 fixed semantic layout";
            return false;
        }
        const uint64_t payloadEnd = static_cast<uint64_t>(cmd[13]) + cmd[14];
        const uint64_t packetEnd = static_cast<uint64_t>(cmd[28]) + cmd[29];
        if (packetEnd != payloadEnd || payloadEnd > corpus.payload.size() * sizeof(uint32_t))
        {
            why = "record " + std::to_string(r) + " packet/payload offsets do not close";
            return false;
        }
    }
    return true;
}

static bool g543RunSemanticReplay(GLFns &f, G178GLExt &e)
{
    if (e.glDispatchCompute_ == nullptr || e.glBindImageTexture_ == nullptr ||
        e.glMemoryBarrier_ == nullptr)
    {
        std::fprintf(stderr, "[G543:sem] FAIL compute/image entry points unavailable; CPU path unchanged\n");
        return false;
    }

    const char *envPath = std::getenv("DC2_G543_CORPUS_PATH");
    if (envPath == nullptr || envPath[0] == '\0')
        envPath = std::getenv("DC2_G542_CORPUS_PATH");
    const std::filesystem::path path = envPath && envPath[0] != '\0'
        ? std::filesystem::path(envPath)
        : std::filesystem::path("captures/g541_vu1_corpus.bin");

    G542AbiCorpus corpus;
    std::string why;
    if (!g542LoadAbiCorpus(path, corpus, why) || !g543ValidateLayout(corpus, why))
    {
        std::fprintf(stderr, "[G543:sem] FAIL path='%s': %s; CPU path unchanged\n",
                     path.string().c_str(), why.c_str());
        return false;
    }

    for (uint32_t r = 0u; r < corpus.records; ++r)
        corpus.commands[static_cast<size_t>(r) * G542_ABI_WORDS + 31u] =
            static_cast<uint32_t>(corpus.payload.size() +
                                  static_cast<size_t>(r) * G543_STATUS_WORDS);

    G542GlObjects gl;
    gl.f = &f;
    if (!g543LinkProgram(f, gl.program, why))
    {
        std::fprintf(stderr, "[G543:sem] FAIL %s; CPU path unchanged\n", why.c_str());
        return false;
    }

    while (glGetError() != GL_NO_ERROR) {}
    uint32_t commandHeight = 0u, payloadHeight = 0u, outputHeight = 0u;
    std::vector<uint32_t> outputInit(
        corpus.payload.size() + static_cast<size_t>(corpus.records) * G543_STATUS_WORDS,
        0xa5a5a5a5u);
    if (!g542CreateImage(gl.textures[0], corpus.commands, commandHeight, why) ||
        !g542CreateImage(gl.textures[1], corpus.payload, payloadHeight, why) ||
        !g542CreateImage(gl.textures[2], outputInit, outputHeight, why))
    {
        std::fprintf(stderr, "[G543:sem] FAIL %s; CPU path unchanged\n", why.c_str());
        return false;
    }

    f.glUseProgram_(gl.program);
    e.glBindImageTexture_(2u, gl.textures[0], 0, GL_FALSE, 0, GL542_READ_ONLY, GL541_R32UI);
    e.glBindImageTexture_(3u, gl.textures[1], 0, GL_FALSE, 0, GL542_READ_ONLY, GL541_R32UI);
    e.glBindImageTexture_(4u, gl.textures[2], 0, GL_FALSE, 0, GL178_READ_WRITE, GL541_R32UI);
    e.glDispatchCompute_(corpus.records, 1u, 1u);
    e.glMemoryBarrier_(GL178_SHADER_IMAGE_ACCESS_BARRIER_BIT | GL178_TEXTURE_UPDATE_BARRIER_BIT);

    std::vector<uint32_t> output(static_cast<size_t>(G542_IMAGE_WIDTH) * outputHeight);
    glBindTexture(GL_TEXTURE_2D, gl.textures[2]);
    glGetTexImage(GL_TEXTURE_2D, 0, GL541_RED_INTEGER, GL_UNSIGNED_INT, output.data());
    const GLenum err = glGetError();
    if (err != GL_NO_ERROR)
    {
        std::fprintf(stderr, "[G543:sem] FAIL readback gl=0x%x; CPU path unchanged\n",
                     static_cast<unsigned>(err));
        return false;
    }

    for (uint32_t r = 0u; r < corpus.records; ++r)
    {
        const size_t c = static_cast<size_t>(r) * G542_ABI_WORDS;
        const size_t s = corpus.commands[c + 31u];
        if (s + G543_STATUS_WORDS > output.size() || output[s] != G543_STATUS_MAGIC)
        {
            const uint32_t magic = s < output.size() ? output[s] : 0u;
            const uint32_t flags = s + 1u < output.size() ? output[s + 1u] : 0xffffffffu;
            const uint32_t pc = s + 2u < output.size() ? output[s + 2u] : 0xffffffffu;
            const uint32_t word = s + 3u < output.size() ? output[s + 3u] : 0u;
            const uint32_t cycles = s + 4u < output.size() ? output[s + 4u] : 0u;
            const uint32_t stop = s + 5u < output.size() ? output[s + 5u] : 0u;
            std::fprintf(stderr,
                         "[G543:sem] FAIL record=%u magic=%08x flags=%08x pc=%04x word=%08x cycles=%u stop=%u; CPU path unchanged\n",
                          r, magic, flags, pc, word, cycles, stop);
            return false;
        }

        const bool statusFailed = output[s + 1u] != 0u;
        if (statusFailed)
        {
            std::fprintf(stderr,
                         "[G543:sem] STATUS record=%u flags=%08x pc=%04x word=%08x cycles=%u/%u stop=%u/%u packets=%u/%u bytes=%u/%u\n",
                         r, output[s + 1u], output[s + 2u], output[s + 3u],
                         output[s + 4u], corpus.commands[c + 10u], output[s + 5u],
                         corpus.commands[c + 12u], output[s + 6u], corpus.commands[c + 27u],
                         output[s + 7u], corpus.commands[c + 29u]);

            // G545 v8 diagnostic: a packet-count failure can leave state exact while one
            // conditional emit block is skipped. Show the bounded generated descriptor stream
            // beside the CPU corpus so the first divergent XGKICK has an address/size identity.
            // This is only reached by the default-off offline oracle and changes no live state.
            const auto *expectedBytes = reinterpret_cast<const uint8_t *>(corpus.payload.data());
            const auto *actualBytes = reinterpret_cast<const uint8_t *>(output.data());
            const uint32_t expectedPackets = corpus.commands[c + 27u];
            const uint32_t actualPackets = output[s + 6u];
            const uint32_t shownPackets = std::min<uint32_t>(
                std::max(expectedPackets, actualPackets), 16u);
            const uint64_t expectedLimit = corpus.payload.size() * sizeof(uint32_t);
            const uint64_t actualLimit = output.size() * sizeof(uint32_t);
            for (uint32_t p = 0u; p < shownPackets; ++p)
            {
                const uint64_t at = static_cast<uint64_t>(corpus.commands[c + 26u]) + p * 8u;
                const bool haveExpected = p < expectedPackets && at + 8u <= expectedLimit;
                const bool haveActual = p < actualPackets && at + 8u <= actualLimit;
                const uint32_t expectedAddr = haveExpected ? g542ReadU32(expectedBytes + at) : 0xffffffffu;
                const uint32_t expectedSize = haveExpected ? g542ReadU32(expectedBytes + at + 4u) : 0xffffffffu;
                const uint32_t actualAddr = haveActual ? g542ReadU32(actualBytes + at) : 0xffffffffu;
                const uint32_t actualSize = haveActual ? g542ReadU32(actualBytes + at + 4u) : 0xffffffffu;
                std::fprintf(stderr,
                             "[G543:packet] record=%u packet=%u expected=%04x/%u actual=%04x/%u\n",
                             r, p, expectedAddr, expectedSize, actualAddr, actualSize);
            }
        }

        G543Mismatch mismatch;
        const uint32_t *cmd = corpus.commands.data() + c;
        if (!g543CompareSection(corpus, output, r, "postState", cmd[16], 632u, mismatch) ||
            !g543CompareSection(corpus, output, r, "postPipe", cmd[18], 644u, mismatch) ||
            !g543CompareSection(corpus, output, r, "postData", cmd[21], 16384u, mismatch) ||
            !g543CompareSection(corpus, output, r, "packetDesc", cmd[26], cmd[27] * 8u, mismatch) ||
            !g543CompareSection(corpus, output, r, "packetBytes", cmd[28], cmd[29], mismatch))
        {
            std::fprintf(stderr,
                         "[G543:sem] FAIL record=%u section=%s byte=%u absoluteByte=%u expected=%02x actual=%02x expectedWord=%08x actualWord=%08x; CPU path unchanged\n",
                         mismatch.record, mismatch.section, mismatch.byte,
                         mismatch.absoluteByte,
                         static_cast<unsigned>(mismatch.expected),
                         static_cast<unsigned>(mismatch.actual),
                         mismatch.expectedWord, mismatch.actualWord);
            if (std::strcmp(mismatch.section, "postState") == 0)
            {
                const auto *expected = reinterpret_cast<const uint8_t *>(corpus.payload.data());
                const auto *actual = reinterpret_cast<const uint8_t *>(output.data());
                uint32_t shown = 0u, total = 0u;
                for (uint32_t w = 0u; w < 632u / 4u; ++w)
                {
                    const uint32_t at = cmd[16] + w * 4u;
                    const uint32_t ew = g542ReadU32(expected + at);
                    const uint32_t aw = g542ReadU32(actual + at);
                    if (ew == aw)
                        continue;
                    ++total;
                    if (shown++ < 12u)
                        std::fprintf(stderr, "[G543:diff] record=%u stateWord=%u expected=%08x actual=%08x\n",
                                     r, w, ew, aw);
                }
                std::fprintf(stderr, "[G543:diff] record=%u postStateDiffWords=%u shown=%u\n",
                             r, total, std::min<uint32_t>(shown, 12u));
            }
            else if (std::strcmp(mismatch.section, "postPipe") == 0)
            {
                const auto *expected = reinterpret_cast<const uint8_t *>(corpus.payload.data());
                const auto *actual = reinterpret_cast<const uint8_t *>(output.data());
                uint32_t shown = 0u, total = 0u;
                for (uint32_t w = 0u; w < 644u / 4u; ++w)
                {
                    const uint32_t at = cmd[18] + w * 4u;
                    const uint32_t ew = g542ReadU32(expected + at);
                    const uint32_t aw = g542ReadU32(actual + at);
                    if (ew == aw)
                        continue;
                    ++total;
                    if (shown++ < 48u)
                        std::fprintf(stderr, "[G543:diff] record=%u pipeWord=%u expected=%08x actual=%08x\n",
                                     r, w, ew, aw);
                }
                std::fprintf(stderr, "[G543:diff] record=%u postPipeDiffWords=%u shown=%u\n",
                             r, total, std::min<uint32_t>(shown, 48u));
            }
            return false;
        }
        if (statusFailed)
            return false;
    }

    std::fprintf(stderr,
                 "[G543:sem] PASS records=%u payload=%lluB exactStateSemanticPipeRamPackets=1 deadHistoryLanesMasked=1 oneReadback=1 CPU-authoritative=1\n",
                 corpus.records, static_cast<unsigned long long>(corpus.payloadBytes));
    return true;
}
