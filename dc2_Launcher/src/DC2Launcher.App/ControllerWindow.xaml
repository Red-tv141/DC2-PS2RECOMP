<Window x:Class="DC2Launcher.App.ControllerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:DC2Launcher.App.ViewModels"
        mc:Ignorable="d"
        Title="Dark Cloud 2 — Controller Configuration" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#1E1E2E" Foreground="#CDD6F4"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="12" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎮 PS2 Controller Mapping &amp; Dead Zones" FontSize="16" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center" />
                <TextBlock Text=" (Versioned Config/controller.json)" FontSize="12" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="10,0,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Content Split: Bindings List vs Options -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Column 1: PS2 Control Binding List -->
            <GroupBox Grid.Column="0" Header="PS2 Control Mappings" Foreground="#89B4FA" Margin="0,0,5,0" Padding="5">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ButtonBindings}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:ButtonBindingItemViewModel}">
                                <Border BorderBrush="#313244" BorderThickness="0,0,0,1" Padding="6,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#CDD6F4" />
                                        <TextBlock Grid.Column="1" Text="{Binding BoundKey}" VerticalAlignment="Center" Foreground="#A6E3A1" Margin="10,0,10,0" />
                                        <Button Grid.Column="2" Content="Rebind" Command="{Binding RebindCommand}" Width="65" Height="24" Background="#45475A" Foreground="#CDD6F4" BorderBrush="#585B70" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </GroupBox>

            <!-- Column 2: Dead Zones & Live Test -->
            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                <!-- Dead Zone Sliders -->
                <GroupBox Header="Stick Dead Zones" Foreground="#89B4FA" Margin="0,0,0,10" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{Binding LeftStickDeadZone, StringFormat='Left Stick Dead Zone: {0:F0}%'}" Foreground="#CDD6F4" />
                        <Slider Minimum="0" Maximum="50" Value="{Binding LeftStickDeadZone}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,5,0,15" />

                        <TextBlock Text="{Binding RightStickDeadZone, StringFormat='Right Stick Dead Zone: {0:F0}%'}" Foreground="#CDD6F4" />
                        <Slider Minimum="0" Maximum="50" Value="{Binding RightStickDeadZone}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,5,0,0" />
                    </StackPanel>
                </GroupBox>

                <!-- Action Button -->
                <Button Content="Reset Default Mappings" Command="{Binding ResetDefaultsCommand}" Height="30" Background="#313244" Foreground="#F38BA8" BorderBrush="#45475A" Margin="0,0,0,10" />
            </StackPanel>
        </Grid>

        <!-- Warnings Area -->
        <Border Grid.Row="2" Background="#313244" CornerRadius="4" Padding="8" Margin="0,0,0,10"
                Visibility="{Binding DuplicateWarnings.Count, Converter={StaticResource BoolToVisConverter}}">
            <ItemsControl ItemsSource="{Binding DuplicateWarnings}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#FAB387" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Status Message -->
        <TextBlock Grid.Row="3" Text="{Binding ValidationStatusMessage}" Foreground="#BAC2DE" Margin="0,0,0,10" FontWeight="SemiBold" />

        <!-- Footer Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save &amp; Apply" Command="{Binding SaveAndCloseCommand}" Width="110" Height="32" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Margin="0,0,10,0" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" Width="90" Height="32" Background="#45475A" Foreground="#CDD6F4" />
        </StackPanel>

        <!-- Input Capture Overlay Modal -->
        <Grid Grid.RowSpan="5" Background="#CC11111B" Visibility="{Binding IsCapturingInput, Converter={StaticResource BoolToVisConverter}}">
            <Border Background="#1E1E2E" BorderBrush="#89B4FA" BorderThickness="2" CornerRadius="8" Padding="30" Width="400" Height="220" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="Press Key to Bind" FontSize="18" FontWeight="Bold" Foreground="#89B4FA" HorizontalAlignment="Center" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding CapturingButtonName}" FontSize="14" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,15" />

                    <TextBlock Text="{Binding CaptureTimeoutSeconds, StringFormat='Timing out in {0} seconds...'}" Foreground="#F9E2AF" HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="Press " Foreground="#BAC2DE" />
                        <TextBlock Text="ESC" FontWeight="Bold" Foreground="#F38BA8" />
                        <TextBlock Text=" to cancel" Foreground="#BAC2DE" />
                    </StackPanel>

                    <Button Content="Cancel Rebind" Command="{Binding CancelRebindCommand}" Width="100" Height="26" Background="#313244" Foreground="#CDD6F4" Margin="0,15,0,0" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
