<Window x:Class="DC2Launcher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dark Cloud 2 Standalone Windows Launcher" 
        Height="620" Width="820" MinHeight="550" MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Icon="dc2_launcher_icon.ico"
        Background="#1E1E2E" Foreground="#CDD6F4">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Custom Dark Theme Styles -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#11111B"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#585B70"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="1" 
                                CornerRadius="4" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#585B70"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#181825" CornerRadius="6" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Dark Cloud 2 Standalone Windows Launcher" FontSize="18" FontWeight="Bold" Foreground="#89B4FA"/>
                    <TextBlock Text="Recompilation Project Companion &amp; Asset Extraction Engine" FontSize="12" Foreground="#A6ADC8"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Border Background="#313244" CornerRadius="4" Padding="8,4">
                        <TextBlock Text="C# / .NET 8 WPF" FontSize="11" Foreground="#89B4FA" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable Main Options -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,4,0">
                
                <!-- Section 1: Game Files & ISO Status -->
                <GroupBox Header="Game Files &amp; Disc Extraction">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding IsoFileName, StringFormat='ISO File: {0}'}" 
                                       ToolTip="{Binding IsoFileName}" TextTrimming="CharacterEllipsis" Margin="0,2"/>
                            <TextBlock Text="{Binding DataStatusText, StringFormat='DATA Status: {0}'}" 
                                       Foreground="#FAB387" Margin="0,2" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Browse ISO..." Command="{Binding BrowseIsoCommand}" IsEnabled="{Binding CanModifySettings}" TabIndex="1"
                                    ToolTip="Choose ISO file location using Windows file picker"/>
                            <Button Content="Extract ISO" Command="{Binding ExtractIsoCommand}" IsEnabled="{Binding CanExtract}" TabIndex="2"
                                    ToolTip="Known Supported: Extract game disc files cleanly into DATA directory using DiscUtils"/>
                            <Button Content="Cancel Extraction" Command="{Binding CancelExtractionCommand}" IsEnabled="{Binding IsExtracting}" TabIndex="3"
                                    ToolTip="Cancel active ISO extraction operation"/>
                            <Button Content="Open DATA" Command="{Binding OpenDataFolderCommand}" TabIndex="4"
                                    ToolTip="Open extracted DATA directory in Windows Explorer"/>
                        </StackPanel>

                        <!-- Extraction Progress Bar -->
                        <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,2" Visibility="{Binding IsExtracting, Converter={StaticResource BoolToVisConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar Height="16" Value="{Binding ExtractionProgress}" Minimum="0" Maximum="100" 
                                         Foreground="#A6E3A1" Background="#313244" BorderThickness="0"/>
                            <TextBlock Grid.Column="1" Text="{Binding ExtractionProgress, StringFormat='{}{0:F0}%'}" Foreground="#A6E3A1" 
                                       FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Section 2: Recomp Game Options & Graphics -->
                <GroupBox Header="Game Options &amp; Graphics">
                    <StackPanel>
                        <CheckBox Content="Skip Intro [Awaiting Recomp Hook]" IsChecked="{Binding SkipIntro}" IsEnabled="{Binding CanModifySettings}" TabIndex="5"
                                  ToolTip="Proposed Recomp Integration: Emits DC2_SKIP_INTRO=1 to child process environment (Requires recomp integration)"/>
                        
                        <CheckBox Content="Enable 60 FPS [Known Supported]" IsChecked="{Binding Enable60Fps}" IsEnabled="{Binding CanModifySettings}" TabIndex="6"
                                  ToolTip="Known Supported: Emits DC2_PATCH_60FPS=1 to child process environment"/>
                        
                        <CheckBox Content="Enable Debug Menu [Known Supported]" IsChecked="{Binding EnableDebugMenu}" IsEnabled="{Binding CanModifySettings}" TabIndex="7"
                                  ToolTip="Known Supported: Emits DC2_DEBUG_MENU=1 to child process environment"/>
                        
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Label Content="Resolution Mode [Awaiting Recomp Hook]:" Target="{Binding ElementName=ComboResMode}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#CDD6F4"/>
                            <ComboBox x:Name="ComboResMode" Grid.Column="1" ItemsSource="{Binding ResolutionModes}" SelectedItem="{Binding SelectedResolutionMode}" 
                                      IsEnabled="{Binding CanModifySettings}" TabIndex="8" ToolTip="Emits DC2_RESOLUTION_WIDTH and DC2_RESOLUTION_HEIGHT"/>

                            <!-- Custom Resolution Width & Height TextBoxes -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0" 
                                        Visibility="{Binding IsCustomResolutionSelected, Converter={StaticResource BoolToVisConverter}}">
                                <Label Content="Width:" Target="{Binding ElementName=TxtWidth}" VerticalAlignment="Center" Foreground="#CDD6F4"/>
                                <TextBox x:Name="TxtWidth" Width="60" Text="{Binding CustomResolutionWidth, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding CanModifySettings}" TabIndex="9" Margin="4,0,8,0"/>
                                
                                <Label Content="Height:" Target="{Binding ElementName=TxtHeight}" VerticalAlignment="Center" Foreground="#CDD6F4"/>
                                <TextBox x:Name="TxtHeight" Width="60" Text="{Binding CustomResolutionHeight, UpdateSourceTrigger=PropertyChanged}" 
                                         IsEnabled="{Binding CanModifySettings}" TabIndex="10" Margin="4,0"/>
                            </StackPanel>
                        </Grid>

                        <CheckBox Content="Fullscreen Mode [Awaiting Recomp Hook]" IsChecked="{Binding Fullscreen}" IsEnabled="{Binding CanModifySettings}" TabIndex="11"
                                  ToolTip="Proposed Recomp Integration: Emits DC2_FULLSCREEN=1 to child process environment"/>
                    </StackPanel>
                </GroupBox>

                <!-- Section 3: Memory Cards & Save Folders -->
                <GroupBox Header="Memory Cards &amp; Save Folders">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Slot 1 -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Memory Card 1 [Awaiting Hook]:" Target="{Binding ElementName=TxtMem1}" VerticalAlignment="Center" Margin="0,4" Foreground="#CDD6F4"/>
                        <TextBox x:Name="TxtMem1" Grid.Row="0" Grid.Column="1" Text="{Binding MemoryCard1Path, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding CanModifySettings}" TabIndex="12" Margin="6,4"/>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Browse..." Command="{Binding BrowseMemCard1Command}" IsEnabled="{Binding CanModifySettings}" TabIndex="13"/>
                            <Button Content="Open Folder" Command="{Binding OpenMemCard1FolderCommand}" TabIndex="14"/>
                            <Button Content="Reset" Command="{Binding ResetMemCard1Command}" IsEnabled="{Binding CanModifySettings}" TabIndex="15"/>
                        </StackPanel>

                        <!-- Slot 2 -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Memory Card 2 [Awaiting Hook]:" Target="{Binding ElementName=TxtMem2}" VerticalAlignment="Center" Margin="0,4" Foreground="#CDD6F4"/>
                        <TextBox x:Name="TxtMem2" Grid.Row="1" Grid.Column="1" Text="{Binding MemoryCard2Path, UpdateSourceTrigger=PropertyChanged}" 
                                 IsEnabled="{Binding CanModifySettings}" TabIndex="16" Margin="6,4"/>
                        <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Browse..." Command="{Binding BrowseMemCard2Command}" IsEnabled="{Binding CanModifySettings}" TabIndex="17"/>
                            <Button Content="Open Folder" Command="{Binding OpenMemCard2FolderCommand}" TabIndex="18"/>
                            <Button Content="Reset" Command="{Binding ResetMemCard2Command}" IsEnabled="{Binding CanModifySettings}" TabIndex="19"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Section 4: Custom Mods & Controller -->
                <GroupBox Header="Mods Folder &amp; Controller Customization">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Content="Enable Mods Folder Override [Awaiting Recomp Hook]" IsChecked="{Binding EnableModsFolder}" IsEnabled="{Binding CanModifySettings}" TabIndex="20"
                                      ToolTip="Proposed Recomp Integration: Emits DC2_MODS_ENABLED=1, DC2_MODS_DIR, and DC2_DATA_DIR (Scans Mods folder for overrides)"/>
                            <Button Grid.Column="1" Content="Open Mods Folder" Command="{Binding OpenModsFolderCommand}" TabIndex="21"
                                    ToolTip="Open Mods override directory in Windows Explorer"/>
                        </Grid>

                        <Grid Margin="0,8,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Controller Customization &amp; Key Rebind Profiles [Awaiting Recomp Hook]" FontWeight="SemiBold" Foreground="#89B4FA"/>
                                <TextBlock Text="Configure keyboard keys &amp; Xbox/XInput controller buttons for all 24 PS2 controls" FontSize="11" Foreground="#A6ADC8"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Customize Controller..." Command="{Binding CustomizeControllerCommand}" IsEnabled="{Binding CanModifySettings}" TabIndex="22"
                                    Background="#313244" BorderBrush="#89B4FA" Foreground="#89B4FA" FontWeight="Bold"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Actions & Diagnostic Area -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="6" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Validate Launch" Command="{Binding ValidateLaunchCommand}" TabIndex="23"
                                ToolTip="Run pre-flight validation check on runner executable, ELF file, and settings"/>
                        <Button Content="Dry Run / Diagnostics" Command="{Binding DryRunLaunchCommand}" IsEnabled="{Binding CanModifySettings}" TabIndex="24"
                                ToolTip="Display exact process launch arguments and environment variables without starting game"/>
                        <Button Content="Open Logs" Command="{Binding OpenLogsFolderCommand}" TabIndex="25"
                                ToolTip="Open launcher log directory in Windows Explorer"/>
                    </StackPanel>

                    <!-- Big Play Button -->
                    <Button Grid.Column="1" Content="PLAY GAME" Command="{Binding PlayCommand}" IsEnabled="{Binding CanPlay}" TabIndex="26"
                            Background="#A6E3A1" Foreground="#11111B" BorderBrush="#A6E3A1" 
                            FontWeight="Bold" FontSize="15" Padding="24,8"/>
                </Grid>

                <!-- Status Message Display Box -->
                <Border Grid.Row="1" Background="#11111B" CornerRadius="4" Padding="10,6" Margin="0,10,0,0">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="#CDD6F4" FontSize="12" TextWrapping="Wrap" 
                               MaxHeight="60" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
